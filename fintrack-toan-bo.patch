+  const calls: { cash: number; base: number }[] = [];
+  let choice: 'defer' | 'overwrite' = 'defer';
+  const h = harness({
+    onConflict: async () => choice,
+    // Máy chủ đang ở phiên bản 7: chỉ chấp nhận khi gửi đúng base = 7
+    save: async (d, base) => {
