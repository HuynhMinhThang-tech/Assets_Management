# Sao chép thành .env.local khi chạy thử ở máy (KHÔNG commit file .env.local lên GitHub)

# Chuỗi kết nối Neon: Neon Console → Dashboard → Connect → chọn "Pooled connection"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Gmail của quản trị viên (nhiều Gmail cách nhau bằng dấu phẩy). Đăng ký bằng Gmail này sẽ tự thành quản trị viên.
ADMIN_EMAIL=ban@gmail.com
