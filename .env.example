# Sao chép thành .env.local khi chạy thử ở máy. KHÔNG commit .env.local (đã được .gitignore chặn).
# Trên Vercel và GitHub Actions: khai báo cùng tên biến này trong phần Environment Variables / Secrets.

# Chuỗi kết nối Neon: Neon Console → Dashboard → Connect → chọn "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Gmail của quản trị viên (nhiều Gmail cách nhau bằng dấu phẩy).
# Đăng ký bằng Gmail này sẽ tự thành quản trị viên.
ADMIN_EMAIL=ten-ban@gmail.com

# Tùy chọn: cổng chạy API khi dev (mặc định theo scripts/dev-api.ts).
# API_PORT=3001

# Tùy chọn (chỉ dùng cho scripts/fetch_prices.py và workflow lấy giá):
# VNSTOCK_API_KEY=
# VNSTOCK_SOURCE=
# VNSTOCK_PRICE_SCALE=
